{
  "ok": true,
  "channel": {
    "name": "email",
    "env": "AGENTSELF_EMAIL_BACKEND",
    "flag": "--email",
    "config": "email_backend",
    "default": "agentmail",
    "note": "email connect does not block init.",
    "backends": [
      {
        "name": "agentmail",
        "summary": "HTTP inbox. Connect provisions or selects an owned address",
        "live": true,
        "verbs": [
          "connect",
          "show",
          "send",
          "receive",
          "list",
          "find",
          "mark"
        ],
        "custody": "none",
        "network": "agentmail",
        "asset": ""
      },
      {
        "name": "imap",
        "summary": "IMAP receive plus SMTP send. Hosts default to imap./smtp. of the address domain",
        "live": true,
        "verbs": [
          "connect",
          "show",
          "send",
          "receive",
          "list",
          "find",
          "mark"
        ],
        "custody": "none",
        "network": "imap-smtp",
        "asset": ""
      }
    ]
  }
}
