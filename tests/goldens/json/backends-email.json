{
  "ok": true,
  "channel": {
    "name": "email",
    "env": "AGENTSELF_EMAIL_BACKEND",
    "flag": "--email",
    "config": "email_backend",
    "default": "agentmail",
    "note": "email connect does not block init.",
    "backends": [
      {
        "name": "agentmail",
        "summary": "HTTP inbox. Connect provisions or selects an owned address",
        "knobs": [
          "email.send.token",
          "email.address",
          "AGENTSELF_AGENTMAIL_API_KEY"
        ],
        "live": true,
        "verbs": [
          "connect",
          "show",
          "send",
          "receive",
          "list"
        ],
        "custody": "none",
        "network": "agentmail",
        "asset": "",
        "options": [
          {
            "name": "credential",
            "type": "secret",
            "required": true,
            "sensitive": true,
            "default": null,
            "choices": [],
            "source": "AGENTSELF_AGENTMAIL_API_KEY",
            "help": "Send credential"
          },
          {
            "name": "address",
            "type": "string",
            "required": false,
            "sensitive": false,
            "default": null,
            "choices": [],
            "source": "",
            "help": "Inbox address when more than one exists"
          }
        ]
      },
      {
        "name": "imap",
        "summary": "IMAP receive plus SMTP send. Hosts default to imap./smtp. of the address domain",
        "knobs": [
          "email.send.token",
          "email.address",
          "AGENTSELF_MAIL_HOST",
          "AGENTSELF_IMAP_HOST",
          "AGENTSELF_SMTP_HOST",
          "AGENTSELF_MAIL_PASSWORD"
        ],
        "live": true,
        "verbs": [
          "connect",
          "show",
          "send",
          "receive",
          "list"
        ],
        "custody": "none",
        "network": "imap-smtp",
        "asset": "",
        "options": [
          {
            "name": "address",
            "type": "string",
            "required": true,
            "sensitive": false,
            "default": null,
            "choices": [],
            "source": "",
            "help": "Mailbox address"
          },
          {
            "name": "credential",
            "type": "secret",
            "required": true,
            "sensitive": true,
            "default": null,
            "choices": [],
            "source": "AGENTSELF_MAIL_PASSWORD",
            "help": "Mailbox credential"
          },
          {
            "name": "mail_host",
            "type": "string",
            "required": false,
            "sensitive": false,
            "default": null,
            "choices": [],
            "source": "AGENTSELF_MAIL_HOST",
            "help": "Shared mail host when IMAP and SMTP share a name"
          },
          {
            "name": "imap_host",
            "type": "string",
            "required": false,
            "sensitive": false,
            "default": null,
            "choices": [],
            "source": "AGENTSELF_IMAP_HOST",
            "help": "IMAP host override"
          },
          {
            "name": "smtp_host",
            "type": "string",
            "required": false,
            "sensitive": false,
            "default": null,
            "choices": [],
            "source": "AGENTSELF_SMTP_HOST",
            "help": "SMTP host override"
          }
        ]
      }
    ]
  }
}
