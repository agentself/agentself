{
  "ok": true,
  "channel": {
    "name": "wallet",
    "command_group": "wallet",
    "next": "agentself wallet address",
    "env": "AGENTSELF_WALLET_BACKEND",
    "flag": "--wallet",
    "config": "wallet_backend",
    "default": "base",
    "note": "RPC override: AGENTSELF_ETH_RPC_URL. wallet send --file is extra payment details this backend interprets. {\"allow\": true} grants TO pull permission. Other files may be 0x call data or {\"signature\", \"args\"} sent to TO. wallet balance ASSET accepts the default asset or a token id.",
    "backends": [
      {
        "name": "base",
        "summary": "USDC destination on Base",
        "live": true,
        "verbs": [
          "show",
          "address",
          "balance",
          "authorize",
          "verify",
          "send"
        ],
        "custody": "eoa-key",
        "network": "base",
        "asset": "USDC"
      },
      {
        "name": "ethereum",
        "summary": "USDC destination on Ethereum",
        "live": true,
        "verbs": [
          "show",
          "address",
          "balance",
          "authorize",
          "verify",
          "send"
        ],
        "custody": "eoa-key",
        "network": "ethereum",
        "asset": "USDC"
      }
    ]
  }
}
